{
  "name": "MyThoughts",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3.1.1",
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-project1": "cds watch --open project1/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-productmngmt": "cds watch --open com.demo.productmngmt/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-ordermngmt": "cds watch --open com.demo.ordermngmt/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/project1",
    "app/productmngmt",
    "app/productmngmt",
    "app/ordermngmt"
  ]
}
